{
  "name": "careeros",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "api"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "npm run dev --workspace @careeros/api",
    "build": "tsc -b && vite build",
    "build:api": "npm run build --workspace @careeros/api",
    "start:api": "npm run start --workspace @careeros/api",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "prisma:generate": "npm run prisma:generate --workspace @careeros/api",
    "prisma:validate": "npm run prisma:validate --workspace @careeros/api",
    "prisma:migrate": "npm run prisma:migrate --workspace @careeros/api",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace @careeros/api",
    "db:check": "npm run db:check --workspace @careeros/api"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5.104.5",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^7.3.7",
    "vitest": "4.1.12"
  }
}
