generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ConnectionStatus {
  NOT_CONNECTED
  REQUESTED
  CONNECTED
}

enum ApplicationStatus {
  SAVED
  APPLIED
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  OTHER
}

enum WorkArrangement {
  ONSITE
  HYBRID
  REMOTE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum EventType {
  INTERVIEW
  ASSESSMENT
  NETWORKING
  OTHER
}

enum VaultFileCategory {
  RESUME
  JOB_DESCRIPTION
  COVER_LETTER
  PORTFOLIO
  CERTIFICATE
  SUPPORTING_DOCUMENT
  OTHER
}

enum VaultFileStatus {
  ACTIVE
  TRASHED
  DELETED
}

enum DocumentRole {
  SUBMITTED_RESUME
  COVER_LETTER
  JOB_DESCRIPTION
  PORTFOLIO
  CERTIFICATE
  SUPPORTING_DOCUMENT
  OTHER
}

enum CompanyResourceType {
  OFFICIAL_WEBSITE
  CAREERS_PAGE
  LINKEDIN
  JOB_POSTING
  COMPANY_BLOG
  DOCUMENTATION
  OTHER
}

model User {
  id             String           @id @default(cuid())
  supabaseAuthId String?          @unique @db.Uuid
  name           String
  email          String           @unique
  firstName      String?
  lastName       String?
  phone          String?
  location       String?
  headline       String?
  bio            String?
  currentRole    String?
  skills         String[]         @default([])
  linkedinUrl    String?
  githubUrl      String?
  portfolioUrl   String?
  companies      Company[]
  contacts       Contact[]
  applications   JobApplication[]
  tasks          Task[]
  events         Event[]
  activities     Activity[]
  vaultFiles           VaultFile[]
  resumeGroups         ResumeGroup[]
  resumeVersions       ResumeVersion[]
  jobDescriptions      JobDescription[]
  companyResources     CompanyResource[]
  applicationDocuments ApplicationDocument[]
  companyDocuments     CompanyDocument[]
  storageUsage         StorageUsage?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
}

model Company {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  website          String?
  careersUrl       String?
  linkedinUrl      String?
  industry         String?
  location         String?
  size             String?
  notes            String?
  tags             String[]          @default([])
  contacts         Contact[]
  applications     JobApplication[]
  tasks            Task[]
  events           Event[]
  activities       Activity[]
  jobDescriptions  JobDescription[]
  companyResources CompanyResource[]
  companyDocuments CompanyDocument[]
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)

  @@index([userId, name])
  @@index([userId, industry])
  @@unique([id, userId])
}

model Contact {
  id                    String           @id @default(cuid())
  userId                String
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId             String?
  company               Company?         @relation(fields: [companyId, userId], references: [id, userId], onDelete: Restrict)
  name                  String
  jobTitle              String?
  linkedinUrl           String?
  email                 String?
  phone                 String?
  connectionStatus      ConnectionStatus @default(NOT_CONNECTED)
  tags                  String[]         @default([])
  connectionRequestedAt DateTime?        @db.Timestamptz(3)
  connectionAcceptedAt  DateTime?        @db.Timestamptz(3)
  lastContactedAt       DateTime?        @db.Timestamptz(3)
  nextFollowUpAt        DateTime?        @db.Timestamptz(3)
  notes                 String?
  tasks                 Task[]
  events                Event[]
  activities            Activity[]
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)

  @@index([userId, name])
  @@index([userId, jobTitle])
  @@index([userId, email])
  @@index([userId, companyId])
  @@index([userId, connectionStatus])
  @@index([userId, nextFollowUpAt])
  @@unique([id, userId])
}

model JobApplication {
  id                   String                @id @default(cuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId            String?
  company              Company?              @relation(fields: [companyId, userId], references: [id, userId], onDelete: Restrict)
  jobTitle             String
  jobDescription       String?
  prepNotes            String?
  jobUrl               String?
  applicationUrl       String?
  status               ApplicationStatus     @default(SAVED)
  jobType              JobType?
  location             String?
  workArrangement      WorkArrangement?
  appliedAt            DateTime?             @db.Timestamptz(3)
  resumeReference      String?
  nextAction           String?
  nextFollowUpAt       DateTime?             @db.Timestamptz(3)
  notes                String?
  tasks                Task[]
  events               Event[]
  activities           Activity[]
  jobDescriptions      JobDescription[]
  applicationDocuments ApplicationDocument[]
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)

  @@index([userId, status])
  @@index([userId, jobTitle])
  @@index([userId, appliedAt])
  @@index([userId, companyId])
  @@index([userId, nextFollowUpAt])
  @@unique([id, userId])
}

model Task {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  dueAt         DateTime?        @db.Timestamptz(3)
  category      String?
  priority      TaskPriority    @default(MEDIUM)
  status        TaskStatus      @default(TODO)
  companyId     String?
  company       Company?        @relation(fields: [companyId, userId], references: [id, userId], onDelete: Restrict)
  contactId     String?
  contact       Contact?        @relation(fields: [contactId, userId], references: [id, userId], onDelete: Restrict)
  applicationId String?
  application   JobApplication? @relation(fields: [applicationId, userId], references: [id, userId], onDelete: Restrict)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)

  @@index([userId, status, dueAt])
  @@index([userId, priority])
  @@index([userId, companyId])
}

model Event {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  eventType     EventType       @default(OTHER)
  startsAt      DateTime        @db.Timestamptz(3)
  endsAt        DateTime?       @db.Timestamptz(3)
  location      String?
  meetingUrl    String?
  notes         String?
  companyId     String?
  company       Company?        @relation(fields: [companyId, userId], references: [id, userId], onDelete: Restrict)
  contactId     String?
  contact       Contact?        @relation(fields: [contactId, userId], references: [id, userId], onDelete: Restrict)
  applicationId String?
  application   JobApplication? @relation(fields: [applicationId, userId], references: [id, userId], onDelete: Restrict)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)

  @@index([userId, startsAt])
  @@index([userId, eventType])
  @@index([userId, companyId])
}

model Activity {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  description   String
  occurredAt    DateTime        @default(now()) @db.Timestamptz(3)
  companyId     String?
  company       Company?        @relation(fields: [companyId, userId], references: [id, userId], onDelete: Restrict)
  contactId     String?
  contact       Contact?        @relation(fields: [contactId, userId], references: [id, userId], onDelete: Restrict)
  applicationId String?
  application   JobApplication? @relation(fields: [applicationId, userId], references: [id, userId], onDelete: Restrict)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)

  @@index([userId, occurredAt])
  @@index([userId, type, occurredAt])
  @@index([userId, companyId])
}

model VaultFile {
  id                   String                @id @default(cuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalFilename     String
  displayName          String
  storagePath          String                @unique
  mimeType             String
  extension            String
  fileSizeBytes        Int
  sha256Hash           String?
  category             VaultFileCategory     @default(OTHER)
  description          String?
  tags                 String[]              @default([])
  uploadSource         String?
  status               VaultFileStatus       @default(ACTIVE)
  deletedAt            DateTime?             @db.Timestamptz(3)
  resumeVersions       ResumeVersion[]
  jobDescriptions      JobDescription[]
  applicationDocuments ApplicationDocument[]
  companyDocuments     CompanyDocument[]
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)

  @@index([userId, status, createdAt])
  @@index([userId, category])
  @@index([userId, displayName])
  @@unique([id, userId])
}

model ResumeGroup {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  targetRole  String?
  description String?
  skills      String[]        @default([])
  isArchived  Boolean         @default(false)
  versions    ResumeVersion[]
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  @@index([userId, isArchived])
  @@index([userId, name])
  @@unique([id, userId])
}

model ResumeVersion {
  id                   String                @id @default(cuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeGroupId        String
  resumeGroup          ResumeGroup           @relation(fields: [resumeGroupId, userId], references: [id, userId], onDelete: Cascade)
  vaultFileId          String
  vaultFile            VaultFile             @relation(fields: [vaultFileId, userId], references: [id, userId], onDelete: Restrict)
  versionNumber        Int
  versionLabel         String
  description          String?
  skills               String[]              @default([])
  isCurrent            Boolean               @default(false)
  applicationDocuments ApplicationDocument[]
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)

  @@unique([id, userId])
  @@unique([resumeGroupId, versionNumber])
  @@index([userId, isCurrent])
  @@index([userId, resumeGroupId])
  @@index([vaultFileId])
}

model JobDescription {
  id                  String            @id @default(cuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId           String?
  company             Company?          @relation(fields: [companyId, userId], references: [id, userId], onDelete: Restrict)
  applicationId       String?
  application         JobApplication?   @relation(fields: [applicationId, userId], references: [id, userId], onDelete: Restrict)
  vaultFileId         String?
  vaultFile           VaultFile?        @relation(fields: [vaultFileId, userId], references: [id, userId], onDelete: Restrict)
  title               String
  location            String?
  experienceLevel     String?
  employmentType      String?
  sourceUrl           String?
  careerPageUrl       String?
  applicationDeadline DateTime?         @db.Timestamptz(3)
  responsibilities    String?
  requiredSkills      String[]          @default([])
  preferredSkills     String[]          @default([])
  descriptionText     String?
  notes               String?
  companyDocuments    CompanyDocument[]
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)

  @@index([userId, companyId])
  @@index([userId, applicationId])
  @@index([userId, title])
  @@unique([id, userId])
}

model CompanyResource {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company             @relation(fields: [companyId, userId], references: [id, userId], onDelete: Cascade)
  title        String
  url          String
  description  String?
  resourceType CompanyResourceType @default(OTHER)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)

  @@index([userId, companyId])
  @@unique([id, userId])
}

model ApplicationDocument {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId   String
  application     JobApplication @relation(fields: [applicationId, userId], references: [id, userId], onDelete: Cascade)
  vaultFileId     String
  vaultFile       VaultFile      @relation(fields: [vaultFileId, userId], references: [id, userId], onDelete: Restrict)
  resumeVersionId String?
  resumeVersion   ResumeVersion? @relation(fields: [resumeVersionId, userId], references: [id, userId], onDelete: Restrict)
  documentRole    DocumentRole   @default(OTHER)
  notes           String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  @@index([userId, applicationId])
  @@index([userId, vaultFileId])
  @@unique([id, userId])
}

model CompanyDocument {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId        String
  company          Company         @relation(fields: [companyId, userId], references: [id, userId], onDelete: Cascade)
  vaultFileId      String?
  vaultFile        VaultFile?      @relation(fields: [vaultFileId, userId], references: [id, userId], onDelete: Cascade)
  jobDescriptionId String?
  jobDescription   JobDescription? @relation(fields: [jobDescriptionId, userId], references: [id, userId], onDelete: Cascade)
  notes            String?
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)

  @@index([userId, companyId])
  @@index([userId, vaultFileId])
  @@index([userId, jobDescriptionId])
  @@unique([id, userId])
}

model StorageUsage {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedBytes BigInt   @default(0)
  fileCount Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
